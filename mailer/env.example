# Copy these lines into .env next to docker-compose.prod.yml on the server
# (that file is git-ignored) and fill in your mailbox's SMTP details.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" only for implicit TLS on port 465; 587 uses STARTTLS automatically.
SMTP_SECURE=false
SMTP_USER=info@zetac.de
SMTP_PASS=change-me
# Sender address; must be a mailbox the SMTP account may send as.
SMTP_FROM=info@zetac.de
MAIL_TO=info@zetac.de
ALLOWED_ORIGINS=https://zetac.de,https://www.zetac.de
