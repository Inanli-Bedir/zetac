# Local development image: runs the Vite dev server with hot reload.
# Used by compose.yaml. Production uses ./Dockerfile (nginx); this file is never deployed.
FROM node:22-alpine

WORKDIR /app

# Install dependencies only; the source is bind-mounted at runtime by
# compose.yaml so edits show up without rebuilding the image.
COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 5173

# --host 0.0.0.0 so the server is reachable from outside the container.
CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
